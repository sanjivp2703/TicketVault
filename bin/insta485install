#!/bin/bash
#
# insta485install
#
# Create a virtual environment, install dependencies and prepare a local
# .env file. Safe to re-run.

set -Eeuo pipefail

python3 -m venv .venv
# shellcheck disable=SC1091
source .venv/bin/activate

pip install --upgrade pip
pip install -r requirements-dev.txt
pip install -e .

if [ ! -f .env ]; then
  cp .env.example .env
  secret_key="$(python -c 'import secrets; print(secrets.token_hex(32))')"
  # Portable in-place edit (BSD and GNU sed)
  sed -i.bak "s/^SECRET_KEY=$/SECRET_KEY=${secret_key}/" .env && rm -f .env.bak
  echo "Created .env with a generated SECRET_KEY. Add your Stripe and Mailgun keys to it."
fi

echo "Installation complete. Next: ./bin/insta485db create && ./bin/insta485run"
