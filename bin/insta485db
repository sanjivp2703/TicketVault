#!/bin/bash
#
# insta485db
#
# Manage the local SQLite database (var/insta485.sqlite3).

set -Eeuo pipefail

DB="var/insta485.sqlite3"

usage() {
  echo "Usage: $0 (create|destroy|reset|dump)"
}

create() {
  mkdir -p var/uploads
  sqlite3 "$DB" < sql/schema.sql
  sqlite3 "$DB" < sql/data.sql
}

destroy() {
  rm -rf "$DB" var/uploads
}

if [ $# -ne 1 ]; then
  usage
  exit 1
fi

case $1 in
  "create")
    if [ -e "$DB" ]; then
      echo "Error: database already exists"
      exit 1
    fi
    create
    ;;

  "destroy")
    destroy
    ;;

  "reset")
    destroy
    create
    ;;

  "dump")
    for table in users transactions monetary_transactions balance_changes; do
      echo "=== ${table} ==="
      sqlite3 -batch -line "$DB" "SELECT * FROM ${table}"
      echo ""
    done
    ;;

  *)
    usage
    exit 1
    ;;
esac
