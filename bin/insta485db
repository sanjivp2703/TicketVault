#!/bin/bash
# insta485db

# Stop on errors
# See https://vaneyckt.io/posts/safer_bash_scripts_with_set_euxo_pipefail/
set -Eeuo pipefail

# Sanity check command line options
usage() {
  echo "Usage: $0 (create|destroy|reset|dump)"
}

if [ $# -ne 1 ]; then
  usage
  exit 1
fi

# Parse argument.  $1 is the first argument
case $1 in
  "create")
    if [ -e "var/insta485.sqlite3" ]; then
        echo "Error: database already exists"
        exit 1
    fi
    mkdir -p var/uploads
    sqlite3 var/insta485.sqlite3 < sql/schema.sql
    sqlite3 var/insta485.sqlite3 < sql/data.sql
    cp sql/uploads/* var/uploads/
    ;;

  "destroy")
    rm -rf var/insta485.sqlite3 var/uploads
    ;;

  "reset")
    rm -rf var/insta485.sqlite3 var/uploads
    mkdir -p var/uploads
    sqlite3 var/insta485.sqlite3 < sql/schema.sql
    sqlite3 var/insta485.sqlite3 < sql/data.sql
    cp sql/uploads/* var/uploads/
    ;;

  "dump")
    sqlite3 -batch -line var/insta485.sqlite3 'SELECT * FROM users'
    sqlite3 -batch -line var/insta485.sqlite3 'SELECT * FROM transactions'

    ;;
  "random")

    for i in $(seq 1 100); do
      # Create random image with text "random <i>"
      convert -size 800x600 xc:lightblue -gravity center -weight bold \
          -pointsize 200 -annotate +0+0 "random $i" \
          "var/uploads/random_$i.jpg"

      # Insert post into database
      echo "INSERT INTO posts (filename, owner) VALUES ('random_$i.jpg', 'awdeorio');" \
        | sqlite3 var/insta485.sqlite3
    done
    ;;

  *)
    usage
    exit 1
    ;;
esac
