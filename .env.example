# Copy this file to .env and fill in the values. Never commit .env.

# --- Flask -----------------------------------------------------------------
# Session signing key. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Development only. Enables password-less sign-in as the seeded seller/admin.
# Leave unset (or 0) in production.
ENABLE_DEV_LOGIN=0

# --- Stripe ----------------------------------------------------------------
# Secret API key (sk_test_... for development, sk_live_... for production).
STRIPE_SECRET_KEY=

# Development only. Enables password-less sign-in as the seeded seller/admin.
# Leave unset (or 0) in production.
ENABLE_DEV_LOGIN=0

# --- Mailgun ---------------------------------------------------------------
# Sending domain and private API key from the Mailgun dashboard.
MAILGUN_DOMAIN=
MAILGUN_API_KEY=
# Optional. Defaults to https://api.mailgun.net/v3/<MAILGUN_DOMAIN>
# MAILGUN_BASE_URL=

# --- SMTP relay used by Flask-Mail (optional; defaults target Mailgun) -------
# MAIL_SERVER=smtp.mailgun.org
# MAIL_PORT=587
# MAIL_USE_TLS=True
# MAIL_USERNAME=postmaster@<MAILGUN_DOMAIN>
# MAIL_PASSWORD=
# MAIL_DEFAULT_SENDER=TicketVault <noreply@<MAILGUN_DOMAIN>>

# --- Gmail SMTP (optional) ---------------------------------------------------
# App password for the Gmail account that sends buyer confirmation emails.
# GMAIL_APP_PASSWORD=
